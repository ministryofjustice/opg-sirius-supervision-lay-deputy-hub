{
  "specName": "e2e/manage_deputy_death_record.cy.js",
  "title": "fetches deputy death record into form",
  "suiteName": "Deputy death record form",
  "testName": "Manage deputy details tab Deputy death record form fetches deputy death record into form",
  "testError": "Timed out retrying after 4000ms: expected 'http://localhost:1234/supervision/deputies/lay/3/record-death' to include '?success=deathRecord'",
  "testCommands": [
    "setCookie Other, other",
    "setCookie XSRF-TOKEN, abcde",
    "visit /supervision/deputies/lay/2",
    "get #record-death",
    "click ",
    "get #proof-of-death-true",
    "assert expected **#proof-of-death-true** to be **checked**",
    "new url http://localhost:1234/supervision/deputies/lay/2/record-death",
    "get [name=\"date-of-death\"]",
    "assert expected **<input#date-of-death.govuk-input.govuk-input--width-10>** to have value **2026-11-03**",
    "get [name=\"date-notified\"]",
    "assert expected **<input#date-notified.govuk-input.govuk-input--width-10>** to have value **2026-11-05**",
    "get [name=\"date-proof-of-death-received\"]",
    "assert expected **<input#date-proof-of-death-received.govuk-input.govuk-input--width-10>** to have value **2026-11-06**",
    "get #notified-by-other",
    "assert expected **<input#notified-by-other.govuk-radios__input>** to be **checked**",
    "get #notification-method-phone",
    "assert expected **<input#notification-method-phone.govuk-radios__input>** to be **checked**",
    "get [name=\"notes\"]",
    "assert expected **<textarea#notes.govuk-textarea.govuk-js-character-count>** to contain text **Neighbour**",
    "visit /supervision/deputies/lay/3",
    "get #record-death",
    "click ",
    "get #proof-of-death-false",
    "assert expected **#proof-of-death-false** to be **checked**",
    "new url http://localhost:1234/supervision/deputies/lay/3/record-death",
    "get [name=\"date-of-death\"]",
    "assert expected **<input#date-of-death.govuk-input.govuk-input--width-10>** to have value **''**",
    "get [name=\"date-notified\"]",
    "assert expected **<input#date-notified.govuk-input.govuk-input--width-10>** to have value **2025-01-01**",
    "get [name=\"date-proof-of-death-received\"]",
    "assert expected **<input#date-proof-of-death-received.govuk-input.govuk-input--width-10>** to have value **''**",
    "get #notified-by-co-deputy",
    "assert expected **<input#notified-by-co-deputy.govuk-radios__input>** to be **checked**",
    "get #notification-method-email",
    "assert expected **<input#notification-method-email.govuk-radios__input>** to be **checked**",
    "get [name=\"notes\"]",
    "assert expected **<textarea#notes.govuk-textarea.govuk-js-character-count>** to contain text **Minimum death record content**",
    "get .govuk-button",
    "click ",
    "url ",
    "assert expected **http://localhost:1234/supervision/deputies/lay/3/record-death** to include **?success=deathRecord**"
  ]
}
