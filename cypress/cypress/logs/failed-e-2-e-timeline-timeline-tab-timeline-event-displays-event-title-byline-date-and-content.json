{
  "specName": "e2e/timeline.cy.js",
  "title": "displays event title, byline, date and content",
  "suiteName": "Timeline event",
  "testName": "Timeline tab Timeline event displays event title, byline, date and content",
  "testError": "Timed out retrying after 4000ms: expected '<time>' to contain '13/10/2026'",
  "testCommands": [
    "setCookie Other, other",
    "setCookie XSRF-TOKEN, abcde",
    "visit /supervision/deputies/lay/1",
    "get :nth-child(3) > .moj-sub-navigation__link",
    "click ",
    "get [data-cy=\"deputy-unlinked-from-order-event\"] > .moj-timeline__header > .moj-timeline__title",
    "new url http://localhost:1234/supervision/deputies/lay/1/timeline",
    "assert expected **<h2.moj-timeline__title>** to contain **Unlink**",
    "get [data-cy=\"deputy-unlinked-from-order-event\"] > .moj-timeline__header > .moj-timeline__byline",
    "assert expected **<p.moj-timeline__byline>** to contain **by system admin (12345678)**",
    "get [data-cy=\"deputy-unlinked-from-order-event\"] > .moj-timeline__date > time",
    "assert expected **<time>** to contain **13/10/2026**"
  ]
}
