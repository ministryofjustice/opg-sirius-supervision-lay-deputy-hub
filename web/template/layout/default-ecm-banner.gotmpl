{{ define "default-ecm-banner" }}
    <div class="moj-banner moj-banner--warning" role="region" aria-label="Warning">
        <svg
            class="moj-banner__icon"
            fill="currentColor"
            role="presentation"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 25 25"
            height="25"
            width="25">
            <path d="M13.6 3.1h-2.3l.3 11.3h1.7l.3-11.3ZM11.4 17.3v2.3h2.3v-2.3h-2.3Z" />
            <path d="M12.5 0 25 22H0L12.5 0Zm0 4.1L3.9 19.3h17.2L12.5 4.1Z" />
        </svg>
        <div class="moj-banner__message">
            <span class="moj-banner__assistive">Warning</span>
            This deputy has a default executive case manager.
        </div>
    </div>
{{ end }}

