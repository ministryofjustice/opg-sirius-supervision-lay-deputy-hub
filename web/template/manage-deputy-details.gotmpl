{{ template "page" . }}

{{ define "main" }}
    {{ template "lay-deputy-details" . }}

     <header class="title-and-buttons-inline">
        <h1 class="govuk-heading-l  govuk-!-margin-bottom-0  govuk-!-margin-top-0">
            {{ .PageName }}
        </h1>
    </header>
    {{ template "error-summary" .Errors }}
    <form method="post"><input type="hidden" name="xsrfToken" value="{{ .XSRFToken}}" />
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-one-half">
                <div class="govuk-form-group {{ if index .Errors "firstname" }} govuk-form-group--error{{ end }}">
                    <label class="govuk-label" for="f-firstname">
                        First name
                    </label>
                    {{ template "error-message" (index .Errors "firstname") }}
                    <input class="govuk-input {{ if index .Errors "firstname" }} govuk-input--error{{ end }}"
                        id="f-firstname"
                        name="deputy-first-name"
                        type="text"
                        value="{{ .DeputyDetails.DeputyFirstName }}">
                </div>

                <div class="govuk-form-group">
                    <label class="govuk-label" for="deputy-middle-name">
                        Middle names (optional)
                    </label>
                    <input class="govuk-input" id="deputy-middle-name" name="deputy-middle-name" type="text" value="{{ .DeputyDetails.DeputyMiddleName }}">
                </div>

                <div class="govuk-form-group {{ if index .Errors "surname" }} govuk-form-group--error{{ end }}">
                    <label class="govuk-label" for="f-surname">
                        Last name
                    </label>
                    {{ template "error-message" (index .Errors "surname") }}
                    <input class="govuk-input {{ if index .Errors "surname" }} govuk-input--error{{ end }}"
                        id="f-surname"
                        name="deputy-last-name"
                        type="text"
                        value="{{ .DeputyDetails.DeputySurname }}">
                </div>

                <div class="govuk-form-group">
                    <label class="govuk-label" for="deputy-other-names">
                        Other names (optional)
                    </label>
                    <input class="govuk-input" id="deputy-other-names" name="deputy-other-names" type="text" value="{{ .DeputyDetails.DeputyOtherNames }}">
                </div>

                <div class="govuk-form-group">
                    <label class="govuk-label" for="deputy-date-of-birth">
                        Date of birth (optional)
                    </label>
                    <input class="govuk-input govuk-input--width-10" id="deputy-date-of-birth" name="deputy-date-of-birth" type="date" value="{{ .DeputyDetails.DeputyDateOfBirth }}">
                </div>

                <div class="govuk-form-group">
                    <label class="govuk-label" for="deputy-mobile-number">
                        Mobile telephone number (optional)
                    </label>
                    <input class="govuk-input" id="deputy-mobile-number" name="deputy-mobile-number" type="text" value="{{ .DeputyDetails.MobileTelephoneNumber }}">
                </div>

                <div class="govuk-form-group">
                    <label class="govuk-label" for="deputy-phone-number">
                        Daytime telephone number (optional)
                    </label>
                    <input class="govuk-input" id="deputy-phone-number" name="deputy-phone-number" type="text" value="{{ .DeputyDetails.DaytimeTelephoneNumber }}">
                </div>

                <div class="govuk-form-group">
                    <label class="govuk-label" for="deputy-evening-number">
                        Evening telephone number (optional)
                    </label>
                    <input class="govuk-input" id="deputy-evening-number" name="deputy-evening-number" type="text" value="{{ .DeputyDetails.EveningTelephoneNumber }}">
                </div>

                <div class="govuk-form-group">
                    <label class="govuk-label" for="deputy-email">
                        Email address (optional)
                    </label>
                    <input class="govuk-input" id="deputy-email" name="deputy-email" type="text" value="{{ .DeputyDetails.Email }}">
                </div>

                <fieldset class="govuk-fieldset">
                    <legend class="govuk-fieldset__legend govuk-fieldset__legend--m">
                        Address
                    </legend>

                    <div class="govuk-form-group {{ if index .Errors "addressLine1" }} govuk-form-group--error{{ end }}">
                        <label class="govuk-label" for="f-addressLine1">
                            Building and street <span class="govuk-visually-hidden">line 1 of 3</span>
                        </label>
                        {{ template "error-message" (index .Errors "addressLine1") }}
                        <input class="govuk-input {{ if index .Errors "addressLine1" }} govuk-input--error{{ end }}"
                            id="f-addressLine1"
                            name="address-line-1"
                            type="text"
                            value="{{ .DeputyDetails.AddressLine1 }}">
                    </div>

                    <div class="govuk-form-group">
                        <label class="govuk-label" for="address-line-2">
                            <span class="govuk-visually-hidden">Building and street line 2 of 3</span>
                        </label>
                        <input class="govuk-input" id="address-line-2" name="address-line-2" type="text" value="{{ .DeputyDetails.AddressLine2 }}">
                    </div>

                    <div class="govuk-form-group">
                        <label class="govuk-label" for="address-line-3">
                            <span class="govuk-visually-hidden">Building and street line 3 of 3</span>
                        </label>
                        <input class="govuk-input" id="address-line-3" name="address-line-3" type="text" value="{{ .DeputyDetails.AddressLine3 }}">
                    </div>

                    <div class="govuk-form-group {{ if index .Errors "town" }} govuk-form-group--error{{ end }}">
                        <label class="govuk-label govuk-!-width-two-thirds" for="f-town">
                            Town or city
                        </label>
                        {{ template "error-message" (index .Errors "town") }}
                        <input class="govuk-input {{ if index .Errors "town" }} govuk-input--error{{ end }}"
                            id="f-town"
                            name="town"
                            type="text"
                            value="{{ .DeputyDetails.Town }}">
                    </div>

                    <div class="govuk-form-group">
                        <label class="govuk-label govuk-!-width-two-thirds" for="county">
                            County (optional)
                        </label>
                        <input class="govuk-input" id="county" name="county" type="text" value="{{ .DeputyDetails.County }}">
                    </div>

                    <div class="govuk-form-group {{ if index .Errors "postcode" }} govuk-form-group--error{{ end }}">
                        <label class="govuk-label" for="f-postcode">
                            Postcode
                        </label>
                        {{ template "error-message" (index .Errors "postcode") }}
                        <input class="govuk-input govuk-input--width-10 {{ if index .Errors "postcode" }} govuk-input--error{{ end }}"
                            id="f-postcode"
                            name="postcode"
                            type="text"
                            value="{{ .DeputyDetails.Postcode }}">
                    </div>

                    <div class="govuk-form-group">
                        <label class="govuk-label govuk-!-width-two-thirds" for="country">
                            Country (optional)
                        </label>
                        <input class="govuk-input" id="country" name="country" type="text" value="{{ .DeputyDetails.Country }}">
                    </div>
                </fieldset>

                <div class="govuk-form-group">
                    <fieldset class="govuk-fieldset">
                        <legend class="govuk-fieldset__legend">
                            Is airmail required?
                        </legend>

                        <div class="govuk-radios__item">
                            <div class="govuk-radios" data-module="govuk-radios" data-govuk-radios-init="">
                                <div class="govuk-radios__item">
                                    <input class="govuk-radios__input" id="airmail-required-true" {{ if .DeputyDetails.IsAirmailRequired }} checked {{ end }} name="airmail-required" type="radio" value="true">
                                    <label class="govuk-label govuk-radios__label" for="airmail-required-true">
                                        Yes
                                    </label>
                                </div>
                                <div class="govuk-radios__item">
                                    <input class="govuk-radios__input" id="airmail-required-false" {{ if .DeputyDetails.IsAirmailRequired }} {{ else }} checked {{ end }} name="airmail-required" type="radio" value="false">
                                    <label class="govuk-label govuk-radios__label" for="airmail-required-false">
                                        No
                                    </label>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                </div>
            </div>
        </div>

        <div class="govuk-button-group govuk-!-margin-top-7" style="border-top: 1px solid #b1b4b6; padding-top: 1em;">
            <button type="submit" class="govuk-button" data-module="govuk-button">
                Save deputy contact details
            </button>
            <a class="govuk-link" href="{{ prefix (printf "/%d" .DeputyDetails.ID) }}">Cancel</a>
        </div>
    </form>



{{ end }}