{{ define "changeset-timeline"}}
        {{ if ne (len .OldValue) 0 }}
            <li><b>{{ .StringValue }}</b> changed from <b>{{ .OldValue }}</b> to <b>{{ .NewValue }}</b></li>
        {{ else }}
            <li><b>{{ .StringValue }}</b> set to <b>{{ .NewValue }}</b></li>
        {{ end }}
    {{end}}