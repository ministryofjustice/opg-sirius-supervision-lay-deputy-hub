{{ define "changeset-timeline"}}
    {{ if eq .FieldName "deputyType"}}
        {{ $myVariable := "Type of deputy" }}
    {{ else if eq .FieldName "relationshipToClient"}}
        {{ $myVariable := "Relationship to client" }}
    {{ else if eq .FieldName "statusChangeDate"}}
        {{ $myVariable := "Status change date" }}
    {{ else if eq .FieldName "statusChangeDate"}}
        {{ $myVariable := "Status on case" }}
    {{ else if eq .FieldName "statusOnCase"}}
        {{ $myVariable := "Status change date" }}


        {{ if ne (len .OldValue) 0 }}
            <li><b>{{ $myVariable }}</b> changed from <b>{{ .OldValue }}</b> to <b>{{ .NewValue  }}</b></li>
        {{ else }}
            <li><b>{{ $myVariable }}</b> set to <b>{{ .NewValue }}</b></li>
        {{ end }}
    {{end}}
{{end}}