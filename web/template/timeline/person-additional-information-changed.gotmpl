{{ define "person-additional-information-changed" }}
    <div class="moj-timeline__item" data-cy="person-additional-information-changed-event">
        <div class="moj-timeline__header">
            <h2 class="moj-timeline__title">
                Additional information
            </h2>
            <p class="moj-timeline__byline">
                {{ printf "by %v (%v)" .User.DisplayName .User.PhoneNumber }}
            </p>
        </div>
        <p class="moj-timeline__date">
            <time>{{ .Timestamp }}</time>
        </p>
        <div class="moj-timeline__description">
            <ul class="govuk-list govuk-list--bullet">
                {{ range .Event.Changes }}
                    {{if eq .FieldName "occupation"}}
                        {{ template "changeset-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "audioTape"}}
                        {{ template "yes-no-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "correspondenceByEmail"}}
                        {{ template "yes-no-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "correspondenceByPhone"}}
                        {{ template "yes-no-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "correspondenceByPost"}}
                        {{ template "yes-no-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "correspondenceByWelsh"}}
                        {{ template "yes-no-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "interpreterRequired"}}
                        {{ template "yes-no-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "hearingImpaired"}}
                        {{ template "yes-no-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "largePrint"}}
                        {{ template "yes-no-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "spellingOfNameRequiresCare"}}
                        {{ template "yes-no-timeline" . }}
                    {{end}}
                {{end}}
            </ul>
        </div>
    </div>
{{ end }}
