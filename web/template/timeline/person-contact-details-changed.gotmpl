{{ define "person-contact-details-changed" }}
    <div class="moj-timeline__item" data-cy="person-contact-details-changed-event">
        <div class="moj-timeline__header">
            <h2 class="moj-timeline__title">
                Contact details updated
            </h2>
            <p class="moj-timeline__byline">
                {{ printf "by %v (%v)" .User.DisplayName .User.PhoneNumber }}
            </p>
        </div>
        <p class="moj-timeline__date">
            <time>{{ .Timestamp }}</time>
        </p>
        <div class="moj-timeline__description">
            <ul class="govuk-list govuk-list--bullet">
                {{ range .Event.Changes }}
                    {{if eq .FieldName "workPhoneNumber"}}
                        {{ template "changeset-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "mobileNumber"}}
                        {{ template "changeset-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "homePhoneNumber"}}
                        {{ template "changeset-timeline" . }}
                    {{end}}
                    {{if eq .FieldName "email"}}
                        {{ template "changeset-timeline" . }}
                    {{end}}
                {{end}}
            </ul>
        </div>
    </div>
{{ end }}
