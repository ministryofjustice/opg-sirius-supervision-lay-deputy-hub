{{ define "yes-no-changeset"}}
    {{ if ne (len .OldValue) 0 }}
        <li>
            <b>{{ .TimelineValueName }}</b> changed from <b>
            {{ if eq .OldValue "1" }}
                Yes
            {{else}}
                No
            {{end}}
            </b> to <b>
                {{ if eq .NewValue "1" }}
                    Yes
                {{else}}
                    No
                {{end}}
            </b>
        </li>
    {{ else }}
        <li><b>{{ .TimelineValueName }}</b> set to <b>
            {{ if eq .NewValue "1" }}
                Yes
            {{else}}
                No
            {{end}}
            </b></li>
    {{ end }}
{{end}}